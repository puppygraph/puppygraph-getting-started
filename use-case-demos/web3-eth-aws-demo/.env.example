AWS_ACCESS_KEY_ID=access_key_id
AWS_SECRET_ACCESS_KEY=secret_access_key
AWS_REGION=your_aws_region

# S3 bucket names are global; suffix with your AWS account ID to keep it unique.
TARGET_BUCKET=aws-web3-eth-demo-YOUR_ACCOUNT_ID
TARGET_DB=eth_iceberg
DATE_START=2026-01-01
DATE_END=2026-01-01

# PuppyGraph default password (publicly known). Change it to your own.
PUPPYGRAPH_PASSWORD=puppygraph123
