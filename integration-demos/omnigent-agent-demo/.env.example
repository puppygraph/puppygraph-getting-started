# Connection settings the PuppyGraph MCP server uses to reach the local
# docker-compose PuppyGraph. Load with: set -a; . ./.env; set +a
#
# openCypher queries (the agent's puppygraph_query tool, language cypher)
PUPPYGRAPH_BOLT_URL=bolt://localhost:7687
# Gremlin queries (puppygraph_query, language gremlin)
PUPPYGRAPH_GREMLIN_URL=ws://localhost:8182/gremlin
# Where the agent's puppygraph_schema tool reads the graph schema back from.
# Uploading schema.json (README step 2) does not use this.
PUPPYGRAPH_SCHEMA_URL=http://localhost:8081/schemajson
# One login for all three endpoints
PUPPYGRAPH_USERNAME=puppygraph
PUPPYGRAPH_PASSWORD=puppygraph123
# OPENAI_API_KEY=sk-...
